rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 4.1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primative Helpers (Pillar 3 & 4.3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_/\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validator: Cached Image (Pillar 4.2)
    function isValidImageCache(data) {
      return data.keys().hasAll(['id', 'imageUrl', 'createdAt'])
        && data.keys().size() == 3
        && data.id is string
        && data.id.size() <= 256
        && data.imageUrl is string
        && data.imageUrl.size() <= 2048
        && data.createdAt == request.time;
    }

    // Entity validator: Favorite Map (Pillar 4.2)
    function isValidFavoriteMap(data) {
      return data.keys().hasAll(['userId', 'name', 'type', 'nodes', 'createdAt'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.type is string && (data.type == 'song' || data.type == 'artist')
        && data.nodes is list && data.nodes.size() <= 100
        && (data.artist == null || (data.artist is string && data.artist.size() <= 256))
        && (data.description == null || (data.description is string && data.description.size() <= 4096))
        && data.createdAt == request.time;
    }

    // Cached Images Collection Route
    match /cached_images/{imageId} {
      allow read: if true;
      allow create: if isValidId(imageId) && isValidImageCache(incoming());
      allow update, delete: if false;
    }

    // Personal user subcollections
    match /users/{userId}/favorites/{favoriteId} {
      allow read, delete: if isOwner(userId) && isValidId(favoriteId);
      allow create: if isOwner(userId) && isValidId(favoriteId) && isValidFavoriteMap(incoming());
      // Updates are restricted and must preserve userId/createdAt mappings
      allow update: if isOwner(userId) && isValidId(favoriteId) && isValidFavoriteMap(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt;
    }
  }
}
